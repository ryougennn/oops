<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Release only: PublishAot also turns off hot reload (MetadataUpdater, startup hooks) in Debug builds. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/oopshell/oopshell.csproj" />
  </ItemGroup>
</Project>
